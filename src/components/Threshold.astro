---
import Plate from './Plate.astro';
import { HERO_SETTLE_ENABLED } from '../config/motion';
import type { ResolvedArtwork } from '../lib/artwork';
interface Props {
  h1: string; lead: string;
  primary: { label: string; href: string }; secondary?: { label: string; href: string };
  art: ResolvedArtwork; art2?: ResolvedArtwork;
  variant?: 'right' | 'wide' | 'pair' | 'left';
}
const { h1, lead, primary, secondary, art, art2, variant = 'right' } = Astro.props;
---
<section class:list={['threshold', `threshold--${variant}`]}>
  <div class="wrap hang">
    <div class="t-text">
      <h1>{h1}</h1>
      <p class="lead">{lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={primary.href}>{primary.label}</a>
        {secondary && <a class="btn btn-secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    {variant === 'right' && <Plate art={art} size="xl" col="7 / span 5" align="start" eager settle={HERO_SETTLE_ENABLED} class="t-art" />}
    {variant === 'wide' && <Plate art={art} size="xl" col="3 / span 10" eager settle={HERO_SETTLE_ENABLED} class="t-art" />}
    {variant === 'left' && <Plate art={art} size="xl" col="1 / span 5" eager settle={HERO_SETTLE_ENABLED} class="t-art" />}
    {variant === 'pair' && <>
      <Plate art={art} size="m" col="7 / span 3" align="end" eager settle={HERO_SETTLE_ENABLED} class="t-art" />
      {art2 && <Plate art={art2} size="s" col="10 / span 3" align="start" drop="48px" eager class="t-art2" />}
    </>}
  </div>
</section>
