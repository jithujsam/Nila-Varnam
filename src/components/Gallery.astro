---
import { getImage } from 'astro:assets';
import ArtworkFrame from './ArtworkFrame.astro';
import { getCategories } from '../lib/artwork';

const groups = getCategories();
const flat = groups.flatMap((g) => g.works);
const big = await Promise.all(flat.map(async (a) => {
  const w = Math.min(1400, a.image.width);
  const img = await getImage({ src: a.image, width: w });
  return { id: a.id, src: img.src, w: img.attributes.width, h: img.attributes.height };
}));
const bigById = Object.fromEntries(big.map((b) => [b.id, b]));
let n = -1;
---
{groups.map((g) => (
  <section class="section" id={g.id}>
    <div class="wrap">
      <div class="section-head"><h2>{g.label}</h2>{g.intro && <p class="lead" style="margin-top:12px">{g.intro}</p>}</div>
      <div class="works gal">
        {g.works.map((a) => { n += 1; return (
          <button type="button" class="work" data-lb={n} aria-label={`Open ${a.title ?? a.alt}`}>
            <ArtworkFrame art={a} eager={n === 0} sizes="(min-width:1280px) 300px, (min-width:640px) 45vw, 90vw" widths={[360, 540, 720]} />
          </button>
        ); })}
      </div>
      <ul class="index">
        {g.works.map((a) => (
          (a.title || a.medium || a.size) && <li><span class="t">{a.title}</span>{a.medium && <span class="m">{a.medium}</span>}{a.size && <span class="m">{a.size}</span>}</li>
        ))}
      </ul>
    </div>
  </section>
))}

<dialog class="lb" id="lb" aria-label="Painting viewer">
  <div class="lb-bar">
    <div style="display:flex;gap:8px;align-items:center">
      <button class="lb-btn" type="button" data-prev aria-label="Previous painting">←</button>
      <span class="lb-count" aria-live="polite"></span>
      <button class="lb-btn" type="button" data-next aria-label="Next painting">→</button>
    </div>
    <button class="lb-btn" type="button" data-close aria-label="Close">×</button>
  </div>
  <div class="lb-body">
    <div class="lb-img"><img alt="" width="800" height="1000" /></div>
    <div class="lb-text"><h2></h2><p class="desc"></p><p class="meta note"></p><a class="btn btn-secondary" href="/contact/?type=commission">Commission something like this</a></div>
  </div>
</dialog>

<script type="application/json" id="lb-data" set:html={JSON.stringify(flat.map((a) => ({ id: a.id, src: bigById[a.id].src, w: bigById[a.id].w, h: bigById[a.id].h, alt: a.alt, title: a.title ?? '', description: a.description ?? '', meta: [a.medium, a.size].filter(Boolean).join(" · ") })))} />

<script>
  const dlg = document.getElementById('lb') as HTMLDialogElement | null;
  const data: { src: string; w: number; h: number; alt: string; title: string; description: string; meta: string }[] = JSON.parse(document.getElementById('lb-data')?.textContent ?? '[]');
  if (dlg && data.length) {
    const img = dlg.querySelector('img') as HTMLImageElement;
    const h2 = dlg.querySelector('h2') as HTMLElement;
    const desc = dlg.querySelector('.desc') as HTMLElement;
    const meta = dlg.querySelector('.meta') as HTMLElement;
    const count = dlg.querySelector('.lb-count') as HTMLElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0; let opener: HTMLElement | null = null;
    const render = (first = false) => {
      const d = data[i];
      const apply = () => {
        img.src = d.src; img.alt = d.alt; img.width = d.w; img.height = d.h;
        h2.textContent = d.title; desc.textContent = d.description; meta.textContent = d.meta;
        h2.hidden = !d.title; desc.hidden = !d.description; meta.hidden = !d.meta;
        count.textContent = `${i + 1} / ${data.length}`;
        img.classList.remove('out');
      };
      if (first || reduce) apply(); else { img.classList.add('out'); setTimeout(apply, 120); }
      const nxt = new Image(); nxt.src = data[(i + 1) % data.length].src;
    };
    const go = (d: number) => { i = (i + d + data.length) % data.length; render(); };
    document.querySelectorAll<HTMLElement>('[data-lb]').forEach((b) => b.addEventListener('click', () => {
      opener = b; i = Number(b.dataset.lb); render(true);
      dlg.showModal(); document.body.style.overflow = 'hidden';
      (dlg.querySelector('[data-close]') as HTMLElement).focus();
    }));
    dlg.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    dlg.querySelector('[data-next]')?.addEventListener('click', () => go(1));
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => { document.body.style.overflow = ''; opener?.focus(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1); else if (e.key === 'ArrowRight') go(1);
      else if (e.key === 'Home') { i = 0; render(); } else if (e.key === 'End') { i = data.length - 1; render(); }
    });
  }
</script>
