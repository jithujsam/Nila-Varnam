---
import BaseLayout from '../components/BaseLayout.astro';
import Entrance from '../components/Entrance.astro';
import Plate from '../components/Plate.astro';
import Stages from '../components/Stages.astro';
import Checklist from '../components/Checklist.astro';
import Faq from '../components/Faq.astro';
import Lightbox from '../components/Lightbox.astro';
import Close from '../components/Close.astro';
import { getPlacement } from '../lib/artwork';
import { sendHospitality, stages, faqHospitality, capacity } from '../data/copy';
import { crumbs, service, faqLd } from '../lib/seo';
const art = getPlacement('hospitalityEntrance');
const note = getPlacement('hospitalityNote');
const desc = 'Original paintings commissioned for hotels, resorts, restaurants and villas across India. Share your project and receive a proposal from the studio.';
---
<BaseLayout path="/hospitality/" title="Custom Artwork for Hotels and Resorts in India" description={desc} jsonLd={[service('Original paintings for hospitality spaces', '/hospitality/', desc), crumbs([['Home', '/'], ['Hospitality', '/hospitality/']]), faqLd(faqHospitality)]}>
  <Entrance variant="wide" meta="Hospitality commissions" h1="Original paintings for hotels, resorts, restaurants <em>and villas</em>" lead="Each painting is commissioned for a specific space and agreed with you, and with your interior designer if you have one, before painting begins." primary={{ label: 'Discuss a hospitality project', href: '/contact/?type=hospitality' }} secondary={{ label: 'See the gallery', href: '/gallery/' }} art={art} />

  <section class="room" aria-labelledby="spaces">
    <div class="wrap cols">
      <div><p class="meta">The spaces</p><h2 id="spaces">Spaces we can paint for</h2><p class="lead" style="margin-top:24px">Subject, medium and scale are agreed per project. Tell us the space and we will advise.</p></div>
      <ul class="tlist" style="margin-top:0">
        <li>Lobbies and reception</li><li>Restaurants and bars</li><li>Guest rooms and suites</li><li>Corridors and landings</li><li>Villas and private residences</li><li>Projects specified by an interior designer or architect</li>
      </ul>
    </div>
  </section>

  <section class="room stone" aria-labelledby="today">
    <div class="wrap hang" style="row-gap:var(--s7)">
      <div style="grid-column:1 / -1" class="today"><p class="meta">An honest note</p><h2 id="today" style="max-width:14ch">What the portfolio shows <em>today</em></h2></div>
      <div class="cols" style="grid-column:1 / -1">
        <div><p class="lead">The paintings in our gallery are portraits and devotional works. They show how the artist handles light, skin tone, fabric and detail.</p><p>Work for hospitality spaces is made to commission, so we begin with your brief and agree the subject before painting.{capacity}</p><a class="link" href="/gallery/">See the gallery</a></div>
        {note && <Plate art={note} size="l" mAlign="right" reveal />}
      </div>
    </div>
  </section>

  <section class="room" aria-labelledby="send">
    <div class="wrap">
      <p class="meta">Your brief</p><h2 id="send">What to send</h2>
      <p class="lead" style="margin-top:24px">Send what you have. A short brief is enough to begin; we will ask for the rest.</p>
      <Checklist items={sendHospitality} two />
    </div>
  </section>

  <section class="room night" aria-labelledby="after">
    <div class="wrap">
      <p class="meta">After you send your brief</p><h2 id="after" style="max-width:14ch">What happens <em>next</em></h2>
      <Stages items={stages} />
      <div class="btn-row"><a class="btn btn-secondary" href="/process/">Read the full process</a></div>
    </div>
  </section>

  <section class="room" aria-labelledby="faq">
    <div class="wrap"><p class="meta">Questions</p><h2 id="faq" style="margin-bottom:var(--s7)">Questions from hospitality teams</h2><Faq items={faqHospitality} /></div>
  </section>

  <Close meta="Hospitality" h2="Discuss a hospitality <em>project</em>" line="Tell us about the property and the walls you want to fill." label="Discuss a hospitality project" href="/contact/?type=hospitality" types={false} />
  <Lightbox />
</BaseLayout>
