---
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Rows from '../components/Rows.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Close from '../components/Close.astro';
import { getPlacement } from '../lib/artwork';
import { faqGifting, capacity } from '../data/copy';
import { crumbs, service, faqLd } from '../lib/seo';
const art = getPlacement('giftingHero');
const desc = 'Hand-painted portraits and original paintings as corporate and executive gifts. Tell us the occasion and quantity and we will propose what is possible.';
---
<BaseLayout path="/gifting/" title="Corporate Art Gifting in India — Hand-Painted Gifts" description={desc} jsonLd={[service('Hand-painted corporate gifts', '/gifting/', desc), crumbs([['Home', '/'], ['Gifting', '/gifting/']]), faqLd(faqGifting)]}>
  <Hero h1="Hand-painted gifts for companies and gifting agencies" lead="A portrait or painting made by hand is a gift that is personal and made once. Tell us the occasion and the quantity and we will propose what is possible." primary={{ label: 'Request a gifting proposal', href: '/contact/?type=gifting' }} secondary={{ label: 'See the gallery', href: '/gallery/' }} art={art} />

  <section class="section alt">
    <div class="wrap">
      <div class="section-head"><h2>Gifts the artist can paint</h2><p class="lead" style="margin-top:12px">Mediums include watercolour, oil, acrylic and sketches.</p></div>
      <Rows items={[
        { title: 'A portrait from a photograph', text: 'For an executive, a retirement or a commemorative occasion.' },
        { title: 'A painting of a subject you choose', text: 'Discussed with the artist and confirmed before painting.' },
        { title: 'A small set for a team or event', text: 'Sizes and numbers are agreed per project.' },
      ]} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <h2>Volume and schedule</h2>
      <div>
        <p class="lead">This is a small studio, so a gifting project suits a small number of meaningful gifts rather than hundreds.</p>
        <p>Tell us the quantity and the date and we will say plainly what fits.{capacity}</p>
      </div>
    </div>
  </section>

  <section class="section stone">
    <div class="wrap">
      <div class="section-head"><h2>How a gifting commission works</h2></div>
      <Steps items={[
        { title: 'Share the occasion', text: 'The occasion, the recipients, the quantity and the date.' },
        { title: 'Receive a proposal', text: 'Subjects, size, medium, schedule and cost.' },
        { title: 'Approve references', text: 'You approve the references and the artist paints.' },
        { title: 'Packing and delivery', text: 'Agreed with you before dispatch.' },
      ]} />
    </div>
  </section>

  <section class="section alt"><div class="wrap"><div class="section-head"><h2>Questions about gifting</h2></div><Faq items={faqGifting} /></div></section>
  <Close h2="Request a gifting proposal" line="Tell us the occasion, the quantity and the date." label="Request a gifting proposal" href="/contact/?type=gifting" />
</BaseLayout>
