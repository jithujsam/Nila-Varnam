---
import BaseLayout from '../components/BaseLayout.astro';
import Entrance from '../components/Entrance.astro';
import Plate from '../components/Plate.astro';
import Stages from '../components/Stages.astro';
import Lightbox from '../components/Lightbox.astro';
import Close from '../components/Close.astro';
import { getPlacement } from '../lib/artwork';
import { stages } from '../data/copy';

const entrance = getPlacement('homeEntrance');
const [bHosp, bGift, bPriv] = getPlacement('homeBands');
const salon = getPlacement('homeSalon');
const practice = getPlacement('homePractice');
const hang = [
  { size: 'l', col: '1 / span 4', m: 'left' },
  { size: 'l', col: '5 / span 5', m: 'right' },
  { size: 'xl', col: '10 / span 3', m: 'center' },
  { size: 'm', col: '2 / span 3', m: 'left' },
  { size: 'm', col: '7 / span 3', m: 'right' },
] as const;
---
<BaseLayout path="/" current="/" title="NILA VARNAM — Commissioned paintings from Kerala" description="Original paintings commissioned for hotels, resorts, companies and private clients across India, by a self-taught artist with about 30 years of practice.">
  <Entrance variant="right" meta="Independent art studio · Kerala, India" h1="Original paintings, <em>made to commission.</em>" lead="A self-taught artist with about 30 years of practice paints for hotels, resorts, companies and private collectors across India." primary={{ label: 'Request a proposal', href: '/contact/?type=general' }} secondary={{ label: 'Enter the gallery', href: '/gallery/' }} art={entrance} />

  <section class="room" aria-labelledby="three">
    <div class="wrap">
      <p class="meta">Commissions</p>
      <h2 id="three" style="max-width:16ch">Three ways to commission an <em>original painting</em></h2>
      <div class="bands">
        <a class="band band--a" href="/hospitality/"><div class="wrap hang" style="width:100%">
          <div class="b-text"><span class="band-no">01 — Hospitality</span><h3>Hospitality</h3><p class="lead">Paintings for hotels, resorts, restaurants and villas, briefed with owners and interior designers.</p><span class="go">Hospitality commissions</span></div>
          {bHosp && <Plate art={bHosp} size="m" reveal />}
        </div></a>
        <a class="band band--b" href="/gifting/"><div class="wrap hang" style="width:100%">
          <div class="b-text"><span class="band-no">02 — Corporate gifting</span><h3>Corporate gifting</h3><p class="lead">Hand-painted gifts for companies, premium clients and gifting agencies: a portrait, a painting or a small set.</p><span class="go">Gifting commissions</span></div>
          {bGift && <Plate art={bGift} size="s" reveal />}
        </div></a>
        <a class="band band--c" href="/commissions/"><div class="wrap hang" style="width:100%">
          <div class="b-text"><span class="band-no">03 — Private commissions</span><h3>Private commissions</h3><p class="lead">Portraits, devotional paintings and personal artwork, painted from your photographs and your brief.</p><span class="go">Private commissions</span></div>
          {bPriv && <Plate art={bPriv} size="m" mAlign="right" reveal />}
        </div></a>
      </div>
    </div>
  </section>

  <section class="room stone" aria-labelledby="selected">
    <div class="wrap">
      <p class="meta">Selected works</p>
      <h2 id="selected" style="max-width:14ch">The gallery, <em>hung whole</em></h2>
      <div class="hang salon">
        {salon.map((a, i) => { const h = hang[i % hang.length]; return <Plate art={a} size={h.size} col={h.col} mAlign={h.m} align="end" reveal={i > 0} />; })}
      </div>
      <div class="btn-row"><a class="btn btn-secondary" href="/gallery/">Walk the whole exhibition</a></div>
    </div>
  </section>

  <section class="room night" aria-labelledby="practice">
    <div class="spot" style="--spot-x:80%;--spot-y:40%" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hang" style="align-items:end">
        <div style="grid-column:1 / span 7"><p class="meta">The practice</p><h2 id="practice" class="statement">Painted by hand, by one self-taught artist.</h2></div>
        {practice && <Plate art={practice} size="m" col="9 / span 4" mAlign="right" reveal />}
      </div>
      <ul class="facts">
        <li><span class="f-big">About 30 years</span><span class="f-sm">of continuous practice</span></li>
        <li><span class="f-big">Self-taught</span><span class="f-sm">learned by observation, experiment and daily work</span></li>
        <li><span class="f-big">Watercolour, oil, acrylic</span><span class="f-sm">plus portraits, sketches and devotional paintings</span></li>
        <li><span class="f-big">Kerala</span><span class="f-sm">working with clients across India</span></li>
      </ul>
      <div class="btn-row"><a class="btn btn-secondary" href="/artist/">About the artist</a></div>
    </div>
  </section>

  <section class="room" aria-labelledby="unfolds">
    <div class="wrap">
      <p class="meta">The process</p>
      <h2 id="unfolds" style="max-width:14ch">How a commission <em>unfolds</em></h2>
      <Stages items={stages} />
      <div class="btn-row"><a class="btn btn-secondary" href="/process/">Read the full process</a></div>
    </div>
  </section>

  <Close line="Tell us what you need. A short brief is enough." />
  <Lightbox />
</BaseLayout>
