---
import BaseLayout from '../components/BaseLayout.astro';
import Threshold from '../components/Threshold.astro';
import Plate from '../components/Plate.astro';
import Wall from '../components/Wall.astro';
import Lines from '../components/Lines.astro';
import Lightbox from '../components/Lightbox.astro';
import Close from '../components/Close.astro';
import { getPlacement } from '../lib/artwork';

const hero = getPlacement('homeHero');
const [p1, p2, p3] = getPlacement('homeWorks');
const dev = getPlacement('homeDevotional');
---
<BaseLayout path="/" current="/" title="NILA VARNAM — Commissioned paintings from Kerala" description="Original paintings commissioned for hotels, designers, corporate gifting and private clients across India, by a self-taught artist with about 30 years of practice.">
  <!-- Entrance -->
  <Threshold variant="right" h1="Commissioned paintings from a Kerala art studio" lead="Original portraits, devotional art and other paintings by one self-taught artist, made to commission across India." primary={{ label: 'Request a proposal', href: '/contact/?type=general' }} secondary={{ label: 'Enter the gallery', href: '/gallery/' }} art={hero} />

  <!-- First room: portraits -->
  <section class="room" aria-labelledby="room-portraits">
    <div class="wrap">
      <div class="room-head"><h2 id="room-portraits">Portraits</h2><p>Portrait paintings, hung whole.</p></div>
      <div class="hang rooms">
        {p1 && <Plate art={p1} size="xl" col="1 / span 6" reveal />}
        {p2 && <Plate art={p2} size="l" col="2 / span 10" mAlign="center" reveal />}
        {p3 && <Plate art={p3} size="s" col="8 / span 3" align="start" mAlign="right" drop="0px" reveal />}
      </div>
    </div>
  </section>

  <!-- Wall text -->
  <Wall link={{ label: 'The artist', href: '/artist/' }}>Painted by hand, by one self-taught artist with about 30 years of practice.</Wall>

  <!-- Commissioning room -->
  <section class="room deep on-teal" aria-labelledby="room-commission">
    <div class="wrap">
      <div class="room-head"><h2 id="room-commission">Commission an original painting</h2><p>Every commission begins with a short brief.</p></div>
      <Lines items={[
        { title: 'Hospitality', text: 'Original paintings for hotels, resorts and restaurants.', href: '/hospitality/' },
        { title: 'Gifting', text: 'Hand-painted gifts for companies and gifting agencies.', href: '/gifting/' },
        { title: 'Private commissions', text: 'Portraits and paintings for private clients.', href: '/commissions/' },
      ]} />
      <a class="btn btn-primary" href="/contact/?type=general">Request a proposal</a>
    </div>
  </section>

  <!-- Second room: devotional -->
  {dev.length > 0 && (
    <section class="room" aria-labelledby="room-devotional">
      <div class="wrap">
        <div class="room-head"><h2 id="room-devotional">Devotional paintings</h2><p>Religious and devotional subjects.</p></div>
        <div class="hang rooms">
          {dev[0] && <Plate art={dev[0]} size="l" col="7 / span 5" mAlign="right" reveal />}
          {dev[1] && <Plate art={dev[1]} size="m" col="2 / span 4" align="end" mAlign="left" reveal />}
        </div>
      </div>
    </section>
  )}

  <Close h2="Tell us about your project" line="Share a short brief and we will reply with next steps." label="Request a proposal" href="/contact/?type=general" />
  <Lightbox />
</BaseLayout>
